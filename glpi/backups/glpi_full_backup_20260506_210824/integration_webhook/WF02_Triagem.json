    {
      "parameters": {
        "jsCode": "\nfunction tp(t){try{return JSON.parse(t)}catch{return null}}\nfunction ext(j){let d=j;const t1=d?.content?.parts?.[0]?.text;if(typeof t1==='string'){const p=tp(t1);if(p)d=p;}\nconst t2=d?.message?.content;if(typeof t2==='string'){const p=tp(t2);if(p)d=p;}return d;}\nconst ch=$('PG: Marcar Classificando').first().json;\nconst raw=$input.first().json||{};\nif(raw.error){\n  return[{json:{chamado:ch,classificacao:{tipo:'MANUTENCAO',executor:'DEMO',categoria:'fallback',justificativa:'Fallback apos erro na IA de classificacao',mensagem_solicitante:''}}}];\n}\nconst r=ext(raw)||{};\nlet tipo=String(r.tipo||'').toUpperCase().trim();\nlet exec=String(r.executor||'').toUpperCase().trim();\nconst tv=['INVIAVEL','OBRA','MANUTENCAO'].includes(tipo);\nconst ev=['NENHUM','DDI_DG','DEMO','SOB_DEMANDA'].includes(exec);\nif(!tv||!ev||(tipo==='INVIAVEL'&&exec!=='NENHUM')||(tipo==='OBRA'&&exec!=='DDI_DG')||\n(tipo==='MANUTENCAO'&&!['DEMO','SOB_DEMANDA'].includes(exec))){\n  const txt=[ch.titulo,ch.descricao,ch.localizacao].join(' ').toLowerCase();\n  const obra=['construcao','ampliacao','novo predio','nova sala','guarita nova','reforma completa','pavimentacao'];\n  const sob=['ar-condicionado','elevador','camera','cftv','portao automatico','caldeira','autoclave'];\n  if(obra.some(k=>txt.includes(k))){tipo='OBRA';exec='DDI_DG';}\n  else if(sob.some(k=>txt.includes(k))){tipo='MANUTENCAO';exec='SOB_DEMANDA';}\n  else{tipo='MANUTENCAO';exec='DEMO';}\n}\nif(tipo==='INVIAVEL')exec='NENHUM';if(tipo==='OBRA')exec='DDI_DG';\nreturn[{json:{chamado:ch,classificacao:{tipo,executor:exec,\ncategoria:r.categoria||'',justificativa:r.justificativa||'Classificado por IA',\nmensagem_solicitante:r.mensagem_solicitante||''}}}];\n"
