    {
      "parameters": {
        "jsCode": "\nconst c=$('Normalizar Dedup').first().json.chamado;\nconst d=$('Normalizar Dedup').first().json.duplicidade;\nconst ref=d.chamado_referencia||{};\nconst base=(process.env.FISCAL_DECISION_BASE_URL||'http://localhost:5678/webhook/fiscal-decisao').replace(/\\/$/,'');\nconst lC=base+'?decisao=confirmar&chamado_id='+c.id+'&ref_id='+(d.chamado_referencia_id||'');\nconst lN=base+'?decisao=nao_duplicado&chamado_id='+c.id;\nconst titulo='[Duplicado] '+(c.titulo||'#'+c.id);\nconst corpo=[\n'[TRIAGEM_IA] Possivel duplicata do chamado #'+(ref.id||d.chamado_referencia_id||'N/A'),\n'Titulo match: '+(ref.titulo||'N/A'),'Status: '+(ref.status_nome||'N/A'),\n'Descricao: '+(ref.descricao||'N/A'),'Local: '+(ref.localizacao||'N/A'),\n'Solicitante: '+(ref.solicitante||'N/A')+' <'+(ref.email_solicitante||'')+'>',\n'Motivo: '+d.justificativa,'',\n'LINKS DE DECISAO:','Confirmar duplicado: '+lC,'NAO duplicado: '+lN].join('\\n');\nreturn[{json:{chamado:c,titulo_novo:titulo,corpo,linkConfirmar:lC,linkNaoDup:lN}}];\n"
      },
