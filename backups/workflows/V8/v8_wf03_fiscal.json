      "name": "Normalizar Reclass",
      "parameters": {
        "jsCode": "\nfunction tp(t){try{return JSON.parse(t)}catch{return null}}\nfunction ext(j){let d=j;const t1=d?.content?.parts?.[0]?.text;if(typeof t1==='string'){const p=tp(t1);if(p)d=p;}\nconst t2=d?.message?.content;if(typeof t2==='string'){const p=tp(t2);if(p)d=p;}return d;}\nconst ch=$('Preparar Reclassificacao').first().json;\nconst raw=$input.first().json||{};\nif(raw.error){\n  const msg=raw.error?.message||raw.error||'Erro na IA de reclassificacao';\n  return[{json:{chamado:ch,erro_ia:true,mensagem_erro:String(msg)}}];\n}\nconst r=ext(raw)||{};\nlet tipo=String(r.tipo||'MANUTENCAO').toUpperCase();\nlet exec=String(r.executor||'DEMO').toUpperCase();\nif(!['INVIAVEL','OBRA','MANUTENCAO'].includes(tipo)){\n  return[{json:{chamado:ch,erro_ia:true,mensagem_erro:'Resposta da IA com tipo invalido'}}];\n}\nif(tipo==='INVIAVEL')exec='NENHUM';if(tipo==='OBRA')exec='DDI_DG';\nif(tipo==='MANUTENCAO'&&!['DEMO','SOB_DEMANDA'].includes(exec)){\n  return[{json:{chamado:ch,erro_ia:true,mensagem_erro:'Resposta da IA com executor invalido'}}];\n}\nreturn[{json:{chamado:ch,classificacao:{tipo,executor:exec,justificativa:r.justificativa||'Reclassificado apos rejeicao de duplicidade',mensagem_solicitante:r.mensagem_solicitante||'',categoria:r.categoria||''},erro_ia:false,mensagem_erro:null}}];\n"
      },
      "position": [
        2520,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
