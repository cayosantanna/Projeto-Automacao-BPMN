        },
        "query": "SELECT id,titulo,descricao,tipo_servico,localizacao,solicitante,email_solicitante,\nstatus_num,status_nome,data_abertura,data_ultima_mudanca,triagem_status,\nclassificacao,duplicado_de_id,motivo_classificacao,em_aprovacao_fiscal\nFROM tickets_processados WHERE id=$1::bigint;"
