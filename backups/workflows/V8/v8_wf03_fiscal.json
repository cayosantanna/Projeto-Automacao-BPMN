      "typeVersion": 2.5
    },
    {
      "id": "wf03-validar",
      "name": "Validar",
      "parameters": {
        "jsCode": "\nconst r=$json;const d=$('Extrair Decisao').first().json;\nlet acao='INVALIDO',msg='';\nif(!r.id){msg='Chamado nao encontrado.';}\nelse if(!r.em_aprovacao_fiscal){msg='Nao aguarda decisao fiscal.';}\nelse if(d.decisao==='confirmar'){acao='CONFIRMAR';msg='Duplicidade confirmada para #'+r.id;}\nelse if(d.decisao==='nao_duplicado'){acao='REJEITAR';msg='Duplicidade rejeitada para #'+r.id;}\nelse{msg='Decisao invalida.';}\nreturn[{json:{...r,acao,msg}}];\n"
      },
      "position": [
        800,
        300
      ],
