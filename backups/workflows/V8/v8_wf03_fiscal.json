    {
      "id": "wf03-rj-acao",
      "name": "Aplicar Reclassificacao",
      "parameters": {
        "jsCode": "\nconst c=$('Normalizar Reclass').first().json;\n// Retorna dados para os proximos nos GLPI atualizarem\nconst tipo=c.classificacao.tipo;const exec=c.classificacao.executor;\nlet glpi_status=4;\nif(tipo==='INVIAVEL'||tipo==='OBRA')glpi_status=6;\nelse if(exec==='DEMO')glpi_status=2;\nelse if(exec==='SOB_DEMANDA')glpi_status=3;\nreturn[{json:{...c,glpi_status}}];\n"
      },
      "position": [
