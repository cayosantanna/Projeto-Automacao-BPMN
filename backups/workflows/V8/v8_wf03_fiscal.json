      "name": "PG: Atualizar Reclass",
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "={{ (() => {\nconst r=$('Aplicar Reclassificacao').first().json;\nconst esc=s=>\"'\"+String(s??'').replace(/'/g,\"''\")+\"'\";\nconst statusNome=r.glpi_status===6?'Fechado':r.glpi_status===2?'Atribuido':'Planejado';\nconst triagem=r.classificacao.tipo==='INVIAVEL'?'FECHADO_INVIAVEL':r.classificacao.tipo==='OBRA'?'FECHADO_OBRA':r.classificacao.executor==='DEMO'?'ATRIBUIDO_DEMO':'ENCAMINHADO_PLANEJADO';\nreturn `UPDATE tickets_processados SET status_num=${Number(r.glpi_status)},status_nome=${esc(statusNome)},triagem_status=${esc(triagem)},classificacao=${esc(r.classificacao.tipo)},executor=${esc(r.classificacao.executor)},em_aprovacao_fiscal=FALSE,motivo_classificacao=${esc(r.classificacao.justificativa)},triado_em=NOW() WHERE id=${Number(r.chamado.id)};`;\n})() }}"
