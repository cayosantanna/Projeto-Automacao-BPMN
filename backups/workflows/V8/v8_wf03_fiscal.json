      "parameters": {
        "jsCode": "\nconst q=$json.query||{};\nconst dec=String(q.decisao??'').toLowerCase().trim();\nconst cid=Number(q.chamado_id);const rid=Number(q.ref_id||0);\nconst ok=Number.isFinite(cid)&&cid>0&&['confirmar','nao_duplicado'].includes(dec);\nreturn[{json:{ok,decisao:dec,chamado_id:ok?cid:null,ref_id:rid>0?rid:null}}];\n"
      },
