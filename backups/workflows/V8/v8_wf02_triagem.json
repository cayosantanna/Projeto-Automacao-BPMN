    },
    {
      "id": "wf02-d1",
      "name": "PG: Historico Dedup",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ String($('Inicio').first().json.chamado.id) }}"
        },
        "query": "SELECT id,titulo,descricao,tipo_servico,localizacao,solicitante,email_solicitante,\nstatus_num,status_nome,data_abertura,data_ultima_mudanca\nFROM tickets_processados WHERE id<>$1::bigint\nAND(status_num IN(1,4) OR(status_num IN(2,3,5,6) AND data_abertura>=NOW()-INTERVAL '90 days'))\nORDER BY data_abertura DESC LIMIT 60;"
      },
      "position": [
        320,
        300
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5
    },
    {
      "id": "wf02-d2",
      "name": "Montar Payload Dedup",
      "parameters": {
        "jsCode": "\nconst hist=$input.all().map(i=>i.json);\nconst atual=$('Inicio').first().json.chamado;\nreturn[{json:{chamado_atual:atual,historico:hist}}];\n"
      },
      "position": [
        560,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "wf02-d3",
      "maxTries": 3,
      "name": "IA: Verificar Duplicidade",
      "onError": "continueErrorOutput",
      "parameters": {
        "builtInTools": {},
        "jsonOutput": true,
        "messages": {
          "values": [
            {
              "content": "=Voce e um assistente de triagem de infraestrutura GLPI.\nTarefa: verificar se o chamado atual e DUPLICADO comparando com o historico.\n\nCHAMADO ATUAL:\n{{ JSON.stringify($json.chamado_atual) }}\n\nHISTORICO (ultimos 3 meses):\n{{ JSON.stringify($json.historico) }}\n\nREGRAS:\n- DUPLICADO se mesmo problema fisico no mesmo local, mesmo com palavras diferentes.\n- Mesmo tipo de equipamento na mesma localizacao em <=30 dias = potencial duplicata.\n- NAO compare o chamado consigo mesmo.\n- Se historico vazio, eh_duplicado=false.\n\nFORMATO JSON puro (sem markdown):\n{\"eh_duplicado\":true|false,\"chamado_referencia_id\":number|null,\"justificativa\":\"string\",\"caracteristicas_match\":[\"string\"]}"
            }
          ]
        },
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.0-flash"
        },
        "options": {}
      },
      "position": [
        800,
        300
      ],
      "retryOnFail": true,
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "waitBetweenTries": 20000
    },
    {
      "id": "wf02-d4",
      "name": "Normalizar Dedup",
      "parameters": {
        "jsCode": "\nfunction tp(t){try{return JSON.parse(t)}catch{return null}}\nfunction ext(j){\n  let d=j;\n  const cands=[\n    d?.content?.parts?.[0]?.text,\n    d?.message?.content,\n    d?.output_text,\n    d?.output,\n    d?.text,\n    d?.response?.text\n  ];\n  for(const t of cands){\n    if(typeof t!=='string')continue;\n    const clean=t.replace(/```json/gi,'').replace(/```/g,'').trim();\n    const direct=tp(clean);\n    if(direct){d=direct;break;}\n    const m=clean.match(/\\{[\\s\\S]*\\}/);\n    if(m?.[0]){const parsed=tp(m[0]);if(parsed){d=parsed;break;}}\n  }\n  return d;\n}\nfunction pb(v){return typeof v==='boolean'?v:typeof v==='string'?['true','sim','yes','1'].includes(v.toLowerCase()):Number(v)===1;}\n\nconst atual=$('Inicio').first().json.chamado;\nconst raw=$input.first().json||{};\nconst hist=$('PG: Historico Dedup').all().map(i=>i.json);\nif(raw.error){\n  const msg=raw.error?.message||raw.error||'Erro na IA de deduplicacao';\n  return[{json:{chamado:atual,erro_ia:true,mensagem_erro:String(msg),duplicidade:{eh_duplicado:false,chamado_referencia_id:null,chamado_referencia:null,justificativa:'IA indisponivel',caracteristicas_match:[]}}}];\n}\nconst r=ext(raw)||{};\nconst dup=r.duplicidade||r;\nconst ehRaw=dup?.eh_duplicado ?? dup?.ehDuplicado ?? dup?.duplicado ?? dup?.is_duplicate ?? dup?.isDuplicated;\nif(ehRaw===undefined){\n  return[{json:{chamado:atual,erro_ia:true,mensagem_erro:'Resposta da IA sem campo eh_duplicado',duplicidade:{eh_duplicado:false,chamado_referencia_id:null,chamado_referencia:null,justificativa:'Resposta invalida da IA',caracteristicas_match:[]}}}];\n}\nconst eh=pb(ehRaw);\nconst refId=Number(dup.chamado_referencia_id ?? dup.chamadoReferenciaId ?? dup.reference_id);\nconst ref=Number.isFinite(refId)?hist.find(h=>Number(h.id)===refId):null;\n\nreturn[{json:{chamado:atual,duplicidade:{\n  eh_duplicado:eh,chamado_referencia_id:eh&&Number.isFinite(refId)?refId:null,\n  chamado_referencia:ref||null,\n  justificativa:dup.justificativa||dup.justificativa_para_fiscal||dup.reason||'Sem justificativa',\n  caracteristicas_match:Array.isArray(dup.caracteristicas_match)?dup.caracteristicas_match:(Array.isArray(dup.matches)?dup.matches:[])\n},erro_ia:false,mensagem_erro:null}}];\n"
      },
      "position": [
        1040,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "wf02-d5",
      "name": "Duplicado?",
      "parameters": {
        "options": {
          "fallbackOutput": "extra"
        },
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "ebf0aa72",
                    "leftValue": "={{ String($json.erro_ia) }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "true"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                }
              },
              "outputKey": "ERRO_IA",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "4cc6235b",
                    "leftValue": "={{ String($json.duplicidade.eh_duplicado) }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "true"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                }
              },
              "outputKey": "DUPLICADO",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "408cde56",
                    "leftValue": "={{ String($json.duplicidade.eh_duplicado) }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "false"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                }
              },
              "outputKey": "NAO_DUP",
              "renameOutput": true
            }
          ]
        }
      },
      "position": [
        1280,
        300
      ],
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2
    },
    {
      "id": "wf02-dedup-err",
      "name": "PG: Reprocessar Erro Dedup",
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "={{ (() => {\nconst d=$json;\nconst ch=d.chamado||d.chamado_atual||$('Inicio').first().json.chamado||{};\nconst esc=s=>\"'\"+String(s??'').replace(/'/g,\"''\")+\"'\";\nconst msg=d.mensagem_erro||d.error?.message||d.error||'Erro na IA de deduplicacao';\nreturn `UPDATE tickets_processados SET triagem_status='ERRO_IA',ultima_acao_workflow='ERRO_IA_DEDUP',\nmotivo_classificacao=${esc(msg)}\nWHERE id=${Number(ch.id)};`;\n})() }}"
      },
      "position": [
        1320,
        -100
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5
    },
    {
      "id": "wf02-dup1",
      "name": "PG: Marcar Duplicado",
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "={{ (() => {\n  const d = $('Normalizar Dedup').first().json;\n  const esc = (s) => \"'\" + String(s ?? '').replace(/'/g, \"''\") + \"'\";\n  const id = Number(d.chamado.id);\n  const ref = Number(d.duplicidade.chamado_referencia_id || 0);\n  return `UPDATE tickets_processados SET status_num=4,status_nome='Pendente',triagem_status='PENDENTE',\nem_aprovacao_fiscal=TRUE,aprovacao_iniciada_em=NOW(),classificacao='POSSIVEL_DUPLICADO',\nduplicado_de_id=${ref},motivo_classificacao=${esc(d.duplicidade.justificativa)},ultima_acao_workflow='AGUARDANDO_FISCAL'\nWHERE id=${id} RETURNING id;`;\n})() }}"
      },
      "position": [
        1320,
        100
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5
    },
    {
      "id": "wf02-dup2",
      "name": "Preparar Followup Dup",
      "parameters": {
        "jsCode": "\nconst c=$('Normalizar Dedup').first().json.chamado;\nconst d=$('Normalizar Dedup').first().json.duplicidade;\nconst ref=d.chamado_referencia||{};\nconst base='http://localhost:5678/webhook/fiscal-decisao-troque-esta-chave-fiscal';\nconst lC=base+'?decisao=confirmar&chamado_id='+c.id+'&ref_id='+(d.chamado_referencia_id||'');\nconst lN=base+'?decisao=nao_duplicado&chamado_id='+c.id;\nconst titulo='[Duplicado] '+(c.titulo||'#'+c.id);\nconst corpo=[\n'[TRIAGEM_IA] Possivel duplicata do chamado #'+(ref.id||d.chamado_referencia_id||'N/A'),\n'Titulo match: '+(ref.titulo||'N/A'),'Status: '+(ref.status_nome||'N/A'),\n'Descricao: '+(ref.descricao||'N/A'),'Local: '+(ref.localizacao||'N/A'),\n'Solicitante: '+(ref.solicitante||'N/A')+' <'+(ref.email_solicitante||'')+'>',\n'Motivo: '+d.justificativa,'',\n'LINKS DE DECISAO:','Confirmar duplicado: '+lC,'NAO duplicado: '+lN].join('\\n');\nreturn[{json:{chamado:c,titulo_novo:titulo,corpo,linkConfirmar:lC,linkNaoDup:lN}}];\n"
      },
      "position": [
        1560,
        100
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
