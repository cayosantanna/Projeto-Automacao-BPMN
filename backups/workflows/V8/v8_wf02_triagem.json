    {
      "id": "wf02-cl2",
      "maxTries": 3,
      "name": "IA: Classificar",
      "onError": "continueErrorOutput",
      "parameters": {
        "builtInTools": {},
        "jsonOutput": true,
        "messages": {
          "values": [
            {
              "content": "=Voce e o Especialista em Triagem de Infraestrutura do IF Sudeste MG - Campus Rio Pomba.\nAvalie o chamado e decida:\n1) INVIAVEL: fora do escopo de manutencao/infraestrutura\n2) OBRA: construcao nova, ampliacao, reforma estrutural -> DDI/DG\n3) MANUTENCAO+DEMO: reparo simples executavel pela equipe interna\n4) MANUTENCAO+SOB_DEMANDA: requer empresa/prestador especializado\n\nCHAMADO:\n{{ JSON.stringify($json) }}\n\nREGRAS OBRA: cria area nova, amplia, altera estrutura, requer projeto engenharia.\nREGRAS DEMO: eletrica simples, hidraulica simples, carpintaria, pintura, serralheria simples, jardinagem.\nREGRAS SOB_DEMANDA: ar-condicionado, elevador, cameras, equipamento lab, portao automatico, caldeira.\n\nFORMATO JSON puro:\n{\"tipo\":\"INVIAVEL\"|\"OBRA\"|\"MANUTENCAO\",\"executor\":\"NENHUM\"|\"DDI_DG\"|\"DEMO\"|\"SOB_DEMANDA\",\"categoria\":\"string\",\"justificativa\":\"string\",\"mensagem_solicitante\":\"string\"}"
            }
          ]
        },
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.0-flash"
        },
        "options": {}
      },
      "position": [
        1800,
        400
      ],
      "retryOnFail": true,
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "waitBetweenTries": 20000
    },
    {
      "id": "wf02-cl3",
      "name": "Normalizar Classificacao",
      "parameters": {
        "jsCode": "\nfunction tp(t){try{return JSON.parse(t)}catch{return null}}\nfunction ext(j){let d=j;const t1=d?.content?.parts?.[0]?.text;if(typeof t1==='string'){const p=tp(t1);if(p)d=p;}\nconst t2=d?.message?.content;if(typeof t2==='string'){const p=tp(t2);if(p)d=p;}return d;}\nconst ch=$('PG: Marcar Classificando').first().json;\nconst raw=$input.first().json||{};\nif(raw.error){\n  const msg=raw.error?.message||raw.error||'Erro na IA de classificacao';\n  return[{json:{chamado:ch,erro_ia:true,mensagem_erro:String(msg)}}];\n}\nlet r=ext(raw)||{};\nlet tipo=String(r.tipo||'').toUpperCase().trim();\nlet exec=String(r.executor||'').toUpperCase().trim();\nconst tv=['INVIAVEL','OBRA','MANUTENCAO'].includes(tipo);\nconst ev=['NENHUM','DDI_DG','DEMO','SOB_DEMANDA'].includes(exec);\nif(!tv||!ev||(tipo==='INVIAVEL'&&exec!=='NENHUM')||(tipo==='OBRA'&&exec!=='DDI_DG')||\n(tipo==='MANUTENCAO'&&!['DEMO','SOB_DEMANDA'].includes(exec))){\n  return[{json:{chamado:ch,erro_ia:true,mensagem_erro:'Resposta da IA com tipo/executor invalido'}}];\n}\nif(tipo==='INVIAVEL')exec='NENHUM';if(tipo==='OBRA')exec='DDI_DG';\nreturn[{json:{chamado:ch,classificacao:{tipo,executor:exec,\ncategoria:r.categoria||'',justificativa:r.justificativa||'Classificado por IA',\nmensagem_solicitante:r.mensagem_solicitante||''},erro_ia:false,mensagem_erro:null}}];\n"
      },
      "position": [
        2040,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
