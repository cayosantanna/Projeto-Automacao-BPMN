      "parameters": {
        "jsCode": "\nlet modo='NOOP',tid=null,origem='DESCONHECIDA';\ntry{\n  const m=$('T1. Manual (Bootstrap)').first()?.json;\n  if(m){modo='INICIAL';origem='MANUAL';}\n}catch(e){}\ntry{\n  const s=$('T3. Schedule 06h/12h').first()?.json;\n  if(s&&s.timestamp){modo='SCHEDULE';origem='SCHEDULE';}\n}catch(e){}\ntry{\n  const w=$('T2. Webhook GLPI').first()?.json;\n  if(w){\n    origem='WEBHOOK';\n    const b=w.body||w;\n    const i=Number(b.ticket_id??b.items_id??b.id);\n    if(i>0){modo='INCREMENTAL';tid=i;}\n    else{modo='NOOP';}\n  }\n}catch(e){}\nreturn[{json:{modo,tid,origem,ts:new Date().toISOString()}}];\n"
      },
