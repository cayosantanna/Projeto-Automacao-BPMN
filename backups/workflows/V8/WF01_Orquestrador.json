    {
      "parameters": {
        "jsCode": "\nconst S={1:'Novo',2:'Atribuido',3:'Planejado',4:'Pendente',5:'Solucionado',6:'Fechado'};\nconst corte=new Date(Date.now()-90*86400000);\nconst ctx=$('Resolver Modo').first().json;\nfunction sn(s){if(typeof s==='number')return s;const t=String(s||'').toLowerCase();\nif(t.includes('novo'))return 1;if(t.includes('atribu'))return 2;if(t.includes('planejad'))return 3;\nif(t.includes('pendent'))return 4;if(t.includes('soluc'))return 5;if(t.includes('fechado')||t.includes('close'))return 6;return Number(s)||null;}\nfunction lh(s){return String(s||'').replace(/<[^>]*>/g,'').trim();}\nlet lista=[];\nfor(const it of $input.all()){const d=it.json;if(Array.isArray(d?.data))lista.push(...d.data);else if(d&&typeof d==='object'&&d['2'])lista.push(d);}\nconst r=lista.map(c=>{const id=Number(c['2']??c.id);const st=sn(c['12']??c.status);\nreturn{id,titulo:c['1']??c.name??'',descricao:lh(c['21']??c.content??''),\ntipo_servico:String(c['14']??c.itilcategories_id??''),localizacao:String(c['83']??c.locations_id??''),\nsolicitante:String(c['4']??c.users_id_recipient??''),email_solicitante:String(c['22']??''),\nstatus_num:st,status_nome:S[st]||'?',data_abertura:c['15']??c.date??null,\ndata_ultima_mudanca:c['19']??c.date_mod??c['15']??null};\n}).filter(c=>{if(!Number.isFinite(c.id)||c.id<=0)return false;\nif(ctx.modo==='INCREMENTAL')return c.status_num===1;\nif([1,4].includes(c.status_num))return true;\nif([3,5,6].includes(c.status_num)){const d=new Date(c.data_abertura);return !isNaN(d)&&d>=corte;}return false;});\nreturn r.map(c=>({json:{chamado:c,modo:ctx.modo}}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        240
      ],
      "id": "wf01-e1",
      "name": "Estruturar Chamados"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ (() => {\n  const c = $json.chamado;\n  const esc = (s) => \"'\" + String(s||'').replace(/'/g, \"''\") + \"'\";\n  const dt = (d) => d ? \"'\" + String(d) + \"'::timestamptz\" : \"NULL\";\n  const ori = esc($json.modo === 'INICIAL' ? 'BOOTSTRAP' : $json.modo === 'SCHEDULE' ? 'SCHEDULE' : 'WEBHOOK');\n  return `INSERT INTO tickets_processados(id,titulo,descricao,tipo_servico,localizacao,solicitante,email_solicitante,status_num,status_nome,data_abertura,data_ultima_mudanca,origem_ingestao)\n   VALUES (${c.id}, ${esc(c.titulo)}, ${esc(c.descricao)}, ${esc(c.tipo_servico)}, ${esc(c.localizacao)}, ${esc(c.solicitante)}, ${esc(c.email_solicitante)}, ${c.status_num}, ${esc(c.status_nome)}, ${dt(c.data_abertura)}, ${dt(c.data_ultima_mudanca)}, ${ori})\n   ON CONFLICT(id) DO UPDATE SET titulo=EXCLUDED.titulo, descricao=EXCLUDED.descricao, tipo_servico=EXCLUDED.tipo_servico, localizacao=EXCLUDED.localizacao, solicitante=EXCLUDED.solicitante, email_solicitante=EXCLUDED.email_solicitante, status_num=EXCLUDED.status_num, status_nome=EXCLUDED.status_nome, data_ultima_mudanca=EXCLUDED.data_ultima_mudanca\n   RETURNING id, status_num, triagem_status, em_aprovacao_fiscal;`;\n})() }}",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        800,
        240
      ],
      "id": "wf01-u1",
      "name": "PG: UPSERT",
      "credentials": {
        "postgres": {
          "id": "PG_TRIAGEM",
          "name": "Postgres Triagem"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst ctx=$('Resolver Modo').first().json;\nif(ctx.modo==='SCHEDULE')return[];\nconst items=$input.all();const allE=$('Estruturar Chamados').all();const out=[];\nfor(const it of items){const u=it.json;\nconst o=allE.find(x=>Number(x.json.chamado.id)===Number(u.id));if(!o)continue;\nconst c=o.json.chamado;const ok=ctx.modo==='INCREMENTAL'?[1]:[1,4];\nif(!ok.includes(c.status_num))continue;\nif(u.triagem_status&&!['PENDENTE','ERRO_IA'].includes(u.triagem_status))continue;\nif(u.em_aprovacao_fiscal===true)continue;\nout.push({json:{chamado:c}});}\nout.sort((a,b)=>Number(a.json.chamado.id)-Number(b.json.chamado.id));\nreturn out.slice(0,4);\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
