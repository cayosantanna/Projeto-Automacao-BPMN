        "query": "={{ (() => {\nconst id=Number($json.chamado.id);\nreturn `UPDATE tickets_processados\nSET triagem_status='ENFILEIRADO', ultima_acao_workflow='ENFILEIRADO_TRIAGEM', atualizado_em=NOW()\nWHERE id=${id}\nAND COALESCE(em_aprovacao_fiscal,FALSE)=FALSE\nAND (triagem_status IS NULL OR triagem_status IN ('PENDENTE','ERRO_IA'))\nRETURNING id;`;\n})() }}",
