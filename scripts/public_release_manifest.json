    "n8n/workflows/Versão9/V9-WF06-Fila-IA.json",
    "scripts/public_release_manifest.json",
    "scripts/validate_public_release.py"
  ],
  "canonical_n8n_workflows": [
    "n8n/workflows/Versão9/V9-WF01-Sincronizador.json",
    "n8n/workflows/Versão9/V9-WF02-Triagem.json",
    "n8n/workflows/Versão9/V9-WF03-Classificacao.json",
    "n8n/workflows/Versão9/V9-WF04-Decisao-Fiscal.json",
    "n8n/workflows/Versão9/V9-WF05-Metricas.json",
    "n8n/workflows/Versão9/V9-WF06-Fila-IA.json"
  ],
  "forbidden_paths": [
    ".agents/**",
    ".codex/**",
    ".git/**",
    ".pytest_cache/**",
    ".venv/**",
    "**/__pycache__/**",
    "**/.gitignore",
    "avaliacao/datasets/**",
    "avaliacao/experimentos/**",
    "avaliacao/resultados/**",
    "avaliacao/sql/**",
    "backups/**",
    "Banco de dados chamados/**",
    "docs/**",
    "local_ai/artifacts/**",
    "local_ai/models/**",
    "n8n/credentials/**",
    "n8n/Nova pasta/**",
    "outputs/**",
    "projeto-ic/**",
    "TrabalhoIC/**"
  ],
  "forbidden_extensions": [
    ".bak",
    ".bin",
    ".csv",
    ".db",
    ".dump",
    ".joblib",
    ".jsonl",
    ".key",
    ".log",
    ".onnx",
    ".p12",
    ".parquet",
    ".pem",
    ".pfx",
    ".pickle",
    ".pkl",
    ".pt",
    ".pth",
    ".pyc",
    ".safetensors",
    ".sql",
    ".sqlite",
    ".sqlite3",
    ".xls",
    ".xlsx",
    ".zip"
  ],
  "forbidden_basenames": [
    ".env",
    ".env.local",
    "api_key.txt",
    "credentials.json",
    "secrets.json"
  ],
  "max_file_bytes": 2097152,
  "n8n_policy": {
    "reject_nonempty_pin_data": true,
    "reject_static_data": true,
    "allow_symbolic_credential_references_only_in_canonical_v9": true,
    "symbolic_credential_id_pattern": "^[A-Z][A-Z0-9_]{2,63}$"
  }
}
