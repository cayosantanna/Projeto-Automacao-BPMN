      "glpi/seed/seed_glpi.py",
      "local_ai/README.md",
      "local_ai/requirements-benchmark.txt",
      "local_ai/requirements-granite.txt",
      "local_ai/requirements-hybrid.txt",
      "local_ai/requirements.txt",
      "n8n/.env.example",
      "n8n/.env.local.example",
      "n8n/LEIA-ME.txt",
      "n8n/docker-compose.yml",
      "n8n/history/README.md",
      "n8n/history/build_history.py",
      "n8n/history/manifest.json",
      "n8n/history/tests/test_public_history.py",
      "n8n/history/validate_history.py",
      "n8n/history/workflows/v1_triagem.json",
      "n8n/history/workflows/v2_triagem.json",
      "n8n/history/workflows/v3_triagem.json",
      "n8n/history/workflows/v4_triagem.json",
      "n8n/history/workflows/v5_triagem.json",
      "n8n/history/workflows/v6_triagem_postgres.json",
      "n8n/history/workflows/v7_triagem_postgres.json",
      "n8n/history/workflows/v8_wf01_orquestrador.json",
