      "n8n/workflows/Versão9/retry_queue_builder.py",
      "n8n/workflows/Versão9/test_v9_hard.py",
      "n8n/workflows/Versão9/test_v9_runtime.py",
      "n8n/workflows/Versão9/validate_v9_static.py",
      "scripts/README_PUBLIC_RELEASE.md",
      "scripts/public_release_manifest.json",
      "scripts/tests/test_validate_public_release.py",
      "scripts/validate_public_release.py"
    ],
    "globs": [
      "avaliacao/config/*.json",
      "avaliacao/prompts/*.txt",
      "avaliacao/schemas/*.json",
      "avaliacao/schemas/*.txt",
      "avaliacao/scripts/*.ps1",
      "avaliacao/scripts/*.py",
      "avaliacao/scripts/*.txt",
      "avaliacao/tests/*.py",
      "local_ai/*.py",
      "local_ai/scripts/*.ps1",
      "local_ai/scripts/*.py",
      "local_ai/tests/*.py"
