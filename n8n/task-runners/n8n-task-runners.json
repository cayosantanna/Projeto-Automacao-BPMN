{
  "task-runners": [
    {
      "runner-type": "javascript",
      "workdir": "/home/runner",
      "command": "/usr/local/bin/node",
      "args": [
        "--disallow-code-generation-from-strings",
        "--disable-proto=delete",
        "/opt/runners/task-runner-javascript/dist/start.js"
      ],
      "health-check-server-port": "5681",
      "allowed-env": [
        "PATH", "GENERIC_TIMEZONE", "NODE_OPTIONS", "HOME",
        "N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT", "N8N_RUNNERS_TASK_TIMEOUT",
        "N8N_RUNNERS_MAX_CONCURRENCY", "GLPI_API_URL", "IA_LOCAL_BASE_URL",
        "IA_FAILOVER_ENABLED", "IA_EXECUTION_MODE", "IA_FIXED_MODEL_ROLE",
        "IA_OPERATIONAL_SEQUENCE",
        "IA_MODEL_LOCAL", "IA_MODEL_SECONDARY", "LOCAL_AI_EMBED_BACKEND",
        "LOCAL_AI_EMBED_MODEL_REVISION", "IA_CONFIANCA_MINIMA",
        "IA_OBRA_CONFIANCA_MINIMA", "DEDUP_CANDIDATE_LIMIT",
        "DEDUP_LOCAL_TOP_K", "DEDUP_POSITIVE_THRESHOLD",
        "DEDUP_NEGATIVE_THRESHOLD", "DEMO_EQUIPE_DISPONIVEL",
        "IA_GENERATION_SEED", "IA_GENERATION_PROFILE", "IA_MODEL_NAME",
        "IA_MODEL_VERSION", "PROMPT_DEDUP_VERSION", "PROMPT_CLASSIF_VERSION",
        "IA_LOCAL_TIMEOUT_MS", "N8N_PUBLIC_BASE_URL", "FISCAL_DECISION_BASE_URL",
        "FISCAL_CONFIRMATION_BASE_URL", "FISCAL_TOKEN_TTL_MINUTOS",
        "WF01_GLPI_CHUNK_SIZE", "FILA_IA_RUN_SCOPE",
        "FILA_IA_LOTE_TAMANHO", "FILA_IA_INTERVALO_SEGUNDOS",
        "FILA_IA_INGRESS_GRACE_SEGUNDOS", "FILA_IA_LEASE_SEGUNDOS",
        "TEST_MODE", "TEST_AUTO_HUMAN_CONFIRMATION"
      ],
      "env-overrides": {
        "NODE_FUNCTION_ALLOW_BUILTIN": "crypto",
        "NODE_FUNCTION_ALLOW_EXTERNAL": "moment",
        "N8N_RUNNERS_HEALTH_CHECK_SERVER_HOST": "0.0.0.0"
      }
    },
    {
      "runner-type": "python",
      "workdir": "/home/runner",
      "command": "/opt/runners/task-runner-python/.venv/bin/python",
      "args": ["-I", "-B", "-X", "disable_remote_debug", "-m", "src.main"],
      "health-check-server-port": "5682",
      "allowed-env": [
        "PATH", "N8N_RUNNERS_LAUNCHER_LOG_LEVEL",
        "N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT", "N8N_RUNNERS_TASK_TIMEOUT",
        "N8N_RUNNERS_MAX_CONCURRENCY"
      ],
      "env-overrides": {
        "N8N_RUNNERS_STDLIB_ALLOW": "",
        "N8N_RUNNERS_EXTERNAL_ALLOW": ""
      }
    }
  ]
}
