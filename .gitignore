# Artefatos reproduziveis do Python
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Ambientes locais e binarios pesados (> 100MB)
.venv/
venv/
**/.env
**/.env.local
**/.env.*
!**/.env.example
!**/.env.local.example
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
backups/n8n/n8n_db.sqlite*
backups/n8n/**
backups/workflows/**
glpi/backups/**
local_ai/models/**
!local_ai/models/manifest.json

# Artefatos locais reproduziveis ou sensiveis
.codex/Memória.md
local_ai/runtime/**
n8n/workflows/all_credentials_export_runtime.json
*.pid

# Saidas intermediarias recuperaveis da selecao comparativa
avaliacao/resultados/**/partials/
avaliacao/resultados/**/execucao.stdout.log
avaliacao/resultados/**/execucao.stderr.log
# Coleta viva local; somente relatórios agregados e redigidos devem ser versionados.
avaliacao/runtime/monitoring/
avaliacao/runtime/backups/
n8n/.env.homolog
glpi/.env.homolog
